{
  "name": "nicaragua-ecosistema",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "db:test": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/rls_smoke.sql",
    "tokens:check": "python3 scripts/check_tokens.py"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "prettier": "^3.3.0"
  }
}
