# Caddy recibe solo tráfico de Cloudflare (modo SSL "Full (strict)") con su certificado de origen.
# Los dominios llegan por variables de entorno desde docker-compose.prod.yml.

{
	auto_https off # El certificado lo da Cloudflare (origen), no Let's Encrypt
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 # Rangos publicados por Cloudflare (revisar en cloudflare.com/ips antes de publicar)
	}
}

{$WEB_DOMAIN}:443 {
	tls /certs/origin.pem /certs/origin-key.pem # Certificado de origen de Cloudflare
	encode zstd gzip # Comprime las respuestas
	reverse_proxy web:3000 # Todo va a la web
}

{$API_DOMAIN}:443 {
	tls /certs/origin.pem /certs/origin-key.pem # Mismo certificado (cubre ambos dominios)
	encode zstd gzip # Comprime las respuestas
	reverse_proxy api:4000 # Todo va a la API
}
