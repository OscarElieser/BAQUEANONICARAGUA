# Copiar a .env.local (web) / .env (api) por entorno. Nunca commitear valores reales.

# --- Firebase (cliente: valores públicos) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Supabase (cliente: solo clave publicable) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Web: servicios públicos ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MAP_STYLE_URL=    # estilo MapLibre de un proveedor con licencia; vacío = mapa desactivado con aviso

# --- API (servidor; SOLO en apps/api y workers) ---
API_PORT=4000
API_PUBLIC_URL=
FIREBASE_PROJECT_ID=
# Credencial de servicio Firebase Admin en base64 (o usar Workload Identity)
FIREBASE_SERVICE_ACCOUNT_B64=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=     # lecturas públicas y peticiones "como el usuario"
SUPABASE_SECRET_KEY=          # equivalente a service_role: nunca en web ni APK
DATABASE_URL=                 # conexión directa para migraciones y pruebas
REDIS_URL=

# --- Función de Supabase "preparar-sesion" (secretos: supabase secrets set ...; nunca en web ni APK) ---
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los pone Supabase automáticamente dentro de la función.
# FIREBASE_PROJECT_ID=        (el mismo de arriba)
# FIREBASE_SERVICE_ACCOUNT=   JSON completo de la cuenta de servicio de Firebase (para agregar role=authenticated)
# ALLOWED_ORIGINS=            orígenes web permitidos, separados por comas (ej. https://dominio.ni)

# --- Proveedores (Fase 0: elegir y contratar) ---
MAP_TILES_URL=
MAP_TILES_KEY=
ROUTING_PROVIDER=
ROUTING_API_KEY=
WEATHER_PROVIDER=
WEATHER_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
AI_PROVIDER=
AI_API_KEY=
